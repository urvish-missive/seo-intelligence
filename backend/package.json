{
  "name": "missive-seo-backend",
  "version": "1.0.0",
  "description": "Missive SEO Intelligence Platform - Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "workers": "node --env-file=.env src/workers/index.js",
    "mcp:stdio": "node --env-file=.env src/mcp/transports/stdio.transport.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:unit": "node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --forceExit",
    "test:integration": "node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --forceExit",
    "lint": "eslint src --ext .js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "axios": "^1.7.9",
    "bullmq": "^5.34.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^190.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.21.0",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^6.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

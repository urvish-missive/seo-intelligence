# ─────────────────────────────────────────────────────────────────────
# Missive SEO Intelligence Platform — Environment Configuration (Backend Prod)
# Copy to backend/.env when deploying the backend standalone to production.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000
FRONTEND_URL=https://seo.missivedigital.com
CORS_ORIGINS=https://seo.missivedigital.com

# Managed MySQL 8.0 cluster (Private VPC IP or Socket)
DATABASE_URL="mysql://missive_prod:PROD_SECURE_PASSWORD@10.0.2.10:3306/missive_seo_prod?connection_limit=25&pool_timeout=10&sslmode=require"

# Managed Redis 7.x
REDIS_HOST=10.0.2.15
REDIS_PORT=6379
REDIS_PASSWORD=PROD_SECURE_REDIS_PASSWORD
REDIS_TLS=false
REDIS_URL="redis://:PROD_SECURE_REDIS_PASSWORD@10.0.2.15:6379/0"

JWT_SECRET=PROD_64_CHAR_RANDOM_HEX_SECRET_GENERATE_WITH_OPENSSL
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=PROD_64_CHAR_REFRESH_SECRET_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=PROD_64_CHAR_REFRESH_SECRET_GENERATE_WITH_OPENSSL
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=PROD_32_CHAR_COOKIE_SECRET

ENCRYPTION_KEY=PROD_64_HEX_CHAR_32_BYTE_ENCRYPTION_KEY

GOOGLE_CLIENT_ID=prod-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=prod-google-client-secret
GOOGLE_REDIRECT_URI=https://seo.missivedigital.com/api/v1/integrations/google/callback

CLARITY_API_BASE_URL=https://www.clarity.ms/export-data/api/v1

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_CONTEXT_TOKENS=8000

MCP_SECRET=PROD_MCP_SECRET_RANDOM_HEX
MCP_WORKSPACE_ID=

FILE_STORAGE_PATH=/var/lib/missive-seo/reports
REPORTS_DIR=/var/lib/missive-seo/reports

DEFAULT_SYNC_INTERVAL_MINUTES=360
MAX_SYNC_RETRIES=3
SYNC_RETRY_DELAY_MS=5000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

LOG_LEVEL=info
LOG_SQL=false

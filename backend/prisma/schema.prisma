  dayOfWeek     Int?
  scheduledTime String?      @db.VarChar(10) // HH:mm
  timezone      String       @default("UTC") @db.VarChar(50)
  recipients    Json?        // Array of recipient email strings
  isActive      Boolean      @default(true)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  createdBy     String?      @db.VarChar(36)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  website   Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  history   ReportHistory[]

  @@map("report_schedules")
  @@index([websiteId])
  @@index([clientId])
  @@index([workspaceId])
  @@index([isActive])
}

model ReportHistory {
  id           String       @id @default(uuid())
  scheduleId   String
  reportId     String?
  status       ReportStatus
  startedAt    DateTime
  completedAt  DateTime?
  errorMessage String?      @db.Text
  createdAt    DateTime     @default(now())

  schedule ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("report_history")
  @@index([scheduleId])
}

model ReportGenerationLog {
  id           String       @id @default(uuid())
  reportId     String
  status       ReportStatus
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  errorMessage String?      @db.Text
  retryCount   Int          @default(0)
  createdAt    DateTime     @default(now())

  report SEOReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_generation_logs")
  @@index([reportId])
}

model ReportBranding {
  id                  String    @id @default(uuid())
  workspaceId         String    @unique
  agencyName          String    @db.VarChar(255)
  logoStorageKey      String?   @db.VarChar(500)
  brandPrimaryColor   String    @default("#4f46e5") @db.VarChar(20)
  brandSecondaryColor String    @default("#0f172a") @db.VarChar(20)
  website             String?   @db.VarChar(255)
  contactEmail        String?   @db.VarChar(255)
  footerText          String?   @db.VarChar(500)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("report_brandings")
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────
// MCP
// ─────────────────────────────────────────────────────────────────────

model MCPClient {
  id          String       @id @default(uuid())
  workspaceId String
  name        String       @db.VarChar(100)
  description String?      @db.VarChar(255)
  transport   MCPTransport @default(STDIO)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accessTokens MCPAccessToken[]
  toolLogs     MCPToolExecutionLog[]

  @@map("mcp_clients")
  @@index([workspaceId])
}

model MCPAccessToken {
  id          String    @id @default(uuid())
  mcpClientId String
  tokenHash   String    @unique @db.VarChar(255)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  mcpClient MCPClient @relation(fields: [mcpClientId], references: [id], onDelete: Cascade)

  @@map("mcp_access_tokens")
  @@index([mcpClientId])
}

model MCPToolExecutionLog {
  id            String   @id @default(uuid())
  mcpClientId   String
  toolName      String   @db.VarChar(100)
  inputParams   Json?
  outputSummary String?  @db.Text
  success       Boolean  @default(true)
  errorMessage  String?  @db.Text
  durationMs    Int?
  userId        String?
  websiteId     String?
  executedAt    DateTime @default(now())

  mcpClient MCPClient @relation(fields: [mcpClientId], references: [id], onDelete: Cascade)

  @@map("mcp_tool_execution_logs")
  @@index([mcpClientId])
  @@index([toolName])
  @@index([executedAt])
}

// ─────────────────────────────────────────────────────────────────────
// BING WEBMASTER TOOLS METRICS
// ─────────────────────────────────────────────────────────────────────

// Daily clicks and impressions (GetRankAndTrafficStats)
model BingDailyMetric {
  id          String   @id @default(uuid())
  websiteId   String
  date        String   @db.VarChar(10)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date])
  @@map("bing_daily_metrics")
  @@index([websiteId])
  @@index([date])
}

// Weekly query stats (GetQueryStats); date = end of Bing's 7-day bucket
model BingQueryMetric {
  id                    String   @id @default(uuid())
  websiteId             String
  date                  String   @db.VarChar(10)
  query                 String   @db.VarChar(1000)
  clicks                Int      @default(0)
  impressions           Int      @default(0)
  avgImpressionPosition Float    @default(0)
  avgClickPosition      Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date, query(length: 300)])
  @@map("bing_query_metrics")
  @@index([websiteId, date])
}

// Weekly page stats (GetPageStats); date = end of Bing's 7-day bucket
model BingPageMetric {
  id                    String   @id @default(uuid())
  websiteId             String
  date                  String   @db.VarChar(10)
  page                  String   @db.VarChar(2048)
  clicks                Int      @default(0)
  impressions           Int      @default(0)
  avgImpressionPosition Float    @default(0)
  avgClickPosition      Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date, page(length: 500)])
  @@map("bing_page_metrics")
  @@index([websiteId, date])
}

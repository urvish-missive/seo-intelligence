# ─────────────────────────────────────────────────────────────────────
# Missive SEO Intelligence Platform — Environment Configuration (Backend Dev)
# Copy to backend/.env for local backend development.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=mysql://missive_user:change_me_password@localhost:3306/missive_seo

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_URL=

JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX

ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_32_BYTES

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google/callback

CLARITY_API_BASE_URL=https://www.clarity.ms/export-data/api/v1

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_CONTEXT_TOKENS=8000

MCP_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX
MCP_WORKSPACE_ID=

FILE_STORAGE_PATH=./storage/reports
REPORTS_DIR=./storage/reports

DEFAULT_SYNC_INTERVAL_MINUTES=360
MAX_SYNC_RETRIES=3
SYNC_RETRY_DELAY_MS=5000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

LOG_LEVEL=info
LOG_SQL=false

# ─────────────────────────────────────────────────────────────────────
# Missive SEO Intelligence Platform — Environment Configuration (Test / CI)
# Used for automated unit and integration tests (Jest, Supertest)
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=3002
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Isolated Test Database
DATABASE_URL=mysql://missive_user:change_me_password@localhost:3306/missive_seo_test

# Test Redis DB
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_URL=redis://127.0.0.1:6379/15

# Fixed Test Secrets (Safe for testing only)
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
JWT_REFRESH_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=0123456789abcdef0123456789abcdef

# Test Encryption Key (32 bytes / 64 hex characters)
ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Mock Google OAuth
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3002/api/v1/integrations/google/callback

# Microsoft Clarity Test Base URL
CLARITY_API_BASE_URL=https://www.clarity.ms/export-data/api/v1

# Local Ollama AI (Mock or test instance)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=10000
OLLAMA_MAX_CONTEXT_TOKENS=4000

# Test MCP Secret
MCP_SECRET=test-mcp-secret-32-characters-00
MCP_WORKSPACE_ID=test-workspace-id

# Isolated Test Report Storage
FILE_STORAGE_PATH=./storage/test-reports
REPORTS_DIR=./storage/test-reports

# Sync Settings for Tests
DEFAULT_SYNC_INTERVAL_MINUTES=60
MAX_SYNC_RETRIES=1
SYNC_RETRY_DELAY_MS=100

# Rate Limits (Relaxed for test suites)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10000
AUTH_RATE_LIMIT_MAX=1000

# Clean Test Logging
LOG_LEVEL=error
LOG_SQL=false

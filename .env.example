# ─────────────────────────────────────────────────────────────────────
# Missive SEO Intelligence Platform — Environment Configuration (Development)
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database (MySQL 8.0) ─────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://missive_user:change_me_password@localhost:3306/missive_seo

# ─── Redis (BullMQ background queues) ─────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
# Optional full connection URL (e.g. redis://default:pass@redis.domain.com:6379)
REDIS_URL=

# ─── Authentication Secrets ───────────────────────────────────────────
# Generate 64-char hex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRY=15m

# Generate separate 64-char hex:
REFRESH_TOKEN_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
REFRESH_TOKEN_EXPIRY=7d

# Generate 32-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX

# ─── Credential Encryption (OAuth tokens, Clarity tokens) ─────────────
# Generate 32-byte (64-char) hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Store and back up securely!
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_32_BYTES

# ─── Google OAuth 2.0 (GA4 & GSC) ─────────────────────────────────────
# Configure in Google Cloud Console with Google Analytics Data API & Search Console API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google/callback

# ─── Microsoft Clarity ────────────────────────────────────────────────
CLARITY_API_BASE_URL=https://www.clarity.ms/export-data/api/v1

# ─── Local AI Assistant (Ollama + Qwen) ───────────────────────────────
# Download Ollama: https://ollama.com
# Pull model: ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_CONTEXT_TOKENS=8000

# ─── Model Context Protocol (MCP) Server ──────────────────────────────
MCP_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX
MCP_WORKSPACE_ID=

# ─── File & Report Storage ────────────────────────────────────────────
FILE_STORAGE_PATH=./storage/reports
REPORTS_DIR=./storage/reports

# ─── Background Job & Sync Settings ───────────────────────────────────
DEFAULT_SYNC_INTERVAL_MINUTES=360
MAX_SYNC_RETRIES=3
SYNC_RETRY_DELAY_MS=5000

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ─── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_SQL=false

# ─────────────────────────────────────────────────────────────────────
# Missive SEO Intelligence Platform — Environment Configuration (Staging)
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000
FRONTEND_URL=https://staging-seo.missivedigital.com
CORS_ORIGINS=https://staging-seo.missivedigital.com

DATABASE_URL="mysql://missive_staging:STAGING_STRONG_PASSWORD@10.0.1.20:3306/missive_seo_staging?connection_limit=15&sslmode=require"

REDIS_HOST=10.0.1.25
REDIS_PORT=6379
REDIS_PASSWORD=STAGING_REDIS_PASSWORD
REDIS_TLS=false
REDIS_URL="redis://:STAGING_REDIS_PASSWORD@10.0.1.25:6379/0"

JWT_SECRET=STAGING_64_CHAR_RANDOM_HEX_SECRET_GENERATE_WITH_OPENSSL
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=STAGING_64_CHAR_REFRESH_SECRET_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=STAGING_64_CHAR_REFRESH_SECRET_GENERATE_WITH_OPENSSL
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=STAGING_32_CHAR_COOKIE_SECRET

ENCRYPTION_KEY=STAGING_64_HEX_CHAR_32_BYTE_ENCRYPTION_KEY

GOOGLE_CLIENT_ID=staging-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=staging-client-secret
GOOGLE_REDIRECT_URI=https://staging-seo.missivedigital.com/api/v1/integrations/google/callback

CLARITY_API_BASE_URL=https://www.clarity.ms/export-data/api/v1

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_CONTEXT_TOKENS=8000

MCP_SECRET=STAGING_MCP_SECRET_RANDOM_HEX
MCP_WORKSPACE_ID=

FILE_STORAGE_PATH=/var/lib/missive-seo/reports
REPORTS_DIR=/var/lib/missive-seo/reports

DEFAULT_SYNC_INTERVAL_MINUTES=360
MAX_SYNC_RETRIES=3
SYNC_RETRY_DELAY_MS=5000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

LOG_LEVEL=info
LOG_SQL=false

# =============================================================================
# Missive Digital SEO Intelligence Platform - Comprehensive Git Ignore
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Environment Variables & Secrets
# NEVER commit real credentials, tokens, or private keys to version control.
# -----------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
.env.local
.env.development
.env.development.local
.env.dev
.env.test
.env.test.local
.env.staging
.env.staging.local
.env.production
.env.production.local
.env.prod
.env.product
.env.live

# Whitelist safe configuration templates & documentation
!**/.env.example
!**/.env.*.example
!**/.env*.example
!**/.env.sample
!**/.env.template

# Keys, certificates, SSH & cloud service account credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
service-account*.json
*-service-account.json
google-credentials*.json
gcp-key*.json
client_secret*.json
token.json
secrets/
.secrets/
*.secret
.npmrc
.htpasswd

# -----------------------------------------------------------------------------
# Generated Reports, PDF, Excel & File Storage
# -----------------------------------------------------------------------------
storage/
**/storage/
!**/storage/**/.gitkeep
reports/
**/reports/
!**/reports/**/.gitkeep
uploads/
**/uploads/
!**/uploads/**/.gitkeep
backups/
**/backups/
!**/backups/**/.gitkeep

# Exclude generated document formats (keep test fixtures)
*.pdf
*.xlsx
*.xls
*.csv
!**/tests/fixtures/**/*.pdf
!**/tests/fixtures/**/*.xlsx
!**/tests/fixtures/**/*.xls
!**/tests/fixtures/**/*.csv

# -----------------------------------------------------------------------------
# Production & Build Artifacts
# -----------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.vite/
**/.vite/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Database, Backups & Container Volumes
# -----------------------------------------------------------------------------
mysql_data/
**/mysql_data/
redis_data/
**/redis_data/
docker-data/
**/docker-data/
*.dump
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal

# Keep Prisma database migrations tracked!
!**/prisma/migrations/**/*.sql

# -----------------------------------------------------------------------------
# Logs, PIDs & Caches
# -----------------------------------------------------------------------------
logs/
**/logs/
*.log
pids/
*.pid
*.seed
*.pid.lock
.cache/
**/.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# -----------------------------------------------------------------------------
# Testing & Code Coverage
# -----------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov

# -----------------------------------------------------------------------------
# AI Engine & Local Large Model Weights
# (Local weights are stored by Ollama in ~/.ollama; don't commit models here)
# -----------------------------------------------------------------------------
models/
**/models/
*.gguf
*.bin
*.safetensors
*.onnx

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------
tmp/
**/tmp/
.tmp/
**/.tmp/
temp/
**/temp/
*.tmp
*.bak
*.swp
*.swo

# -----------------------------------------------------------------------------
# Operating System & Editor Artifacts
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
**/.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI Assistant local memory & session metadata
.claude/settings.local.json
CLAUDE.local.md
